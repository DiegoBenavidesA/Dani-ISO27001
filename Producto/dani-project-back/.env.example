# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/normia

# Seguridad JWT
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=240

# Configuracion de la API
API_V1_STR=/api/v1
PROJECT_NAME=DANI27001
DEBUG=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Proveedores de IA (configure al menos uno)
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# Correo SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=DANI GRC
EMAIL_FROM=

# Brevo HTTP (tiene prioridad sobre SMTP cuando esta configurado)
BREVO_API_KEY=

# URLs del frontend
FRONTEND_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# Supabase Storage
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-key
SUPABASE_STORAGE_BUCKET=evidence

# Google Cloud Storage (opcionales)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
CLOUD_STORAGE_BUCKET=

# Vector Store (actualmente opcional, [completar] si se activa)
VECTOR_STORE_API_KEY=
VECTOR_STORE_ENVIRONMENT=gcp-starter

# CORS (lista usada por Settings si se consume; main.py mantiene lista propia)
CORS_ORIGINS=["http://localhost:3000","https://dani-iso-27001.vercel.app"]

# Usuarios creados automaticamente al iniciar
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=replace-with-a-local-only-password
